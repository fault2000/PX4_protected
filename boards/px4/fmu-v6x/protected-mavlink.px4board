# Protected MAVLink bring-up target. This file overlays default.px4board.
# Keep diagnostic/flight exclusions aligned with protected.px4board.
# Disable inherited flight modules and device drivers explicitly.
CONFIG_BOARD_PROTECTED=y
CONFIG_BOARD_ETHERNET=n
CONFIG_BOARD_ADDITIONAL_INIT="rc.protected-mavlink"
# CONFIG_BOARD_UAVCAN_TIMER_OVERRIDE is not set
CONFIG_MAVLINK_DIALECT="development"
# CONFIG_NUM_MISSION_ITMES_SUPPORTED is not set
CONFIG_DRIVERS_ADC_ADS1115=n
CONFIG_DRIVERS_ADC_BOARD_ADC=n
CONFIG_DRIVERS_BAROMETER_BMP388=n
CONFIG_DRIVERS_BAROMETER_INVENSENSE_ICP201XX=n
CONFIG_DRIVERS_BAROMETER_MS5611=n
CONFIG_DRIVERS_CAMERA_CAPTURE=n
CONFIG_DRIVERS_CAMERA_TRIGGER=n
CONFIG_DRIVERS_CDCACM_AUTOSTART=n
CONFIG_COMMON_DIFFERENTIAL_PRESSURE=n
CONFIG_DRIVERS_DIFFERENTIAL_PRESSURE_AUAV=n
CONFIG_COMMON_DISTANCE_SENSOR=n
CONFIG_DRIVERS_DSHOT=n
CONFIG_DRIVERS_GNSS_SEPTENTRIO=n
CONFIG_DRIVERS_GPS=n
CONFIG_DRIVERS_HEATER=n
CONFIG_DRIVERS_IMU_ANALOG_DEVICES_ADIS16470=n
CONFIG_DRIVERS_IMU_BOSCH_BMI088=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20602=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20649=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20948=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42670P=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42688P=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM45686=n
CONFIG_DRIVERS_IMU_INVENSENSE_IIM42652=n
CONFIG_COMMON_LIGHT=n
CONFIG_COMMON_MAGNETOMETER=n
CONFIG_DRIVERS_OSD_MSP_OSD=n
CONFIG_DRIVERS_POWER_MONITOR_INA226=n
CONFIG_DRIVERS_POWER_MONITOR_INA228=n
CONFIG_DRIVERS_POWER_MONITOR_INA238=n
CONFIG_DRIVERS_PWM_INPUT=n
CONFIG_DRIVERS_PWM_OUT=n
CONFIG_DRIVERS_PX4IO=n
CONFIG_COMMON_RC=n
CONFIG_DRIVERS_SAFETY_BUTTON=n
CONFIG_DRIVERS_TONE_ALARM=n
CONFIG_DRIVERS_UAVCAN=n
CONFIG_MODULES_AIRSPEED_SELECTOR=n
CONFIG_MODULES_BATTERY_STATUS=n
CONFIG_MODULES_CAMERA_FEEDBACK=n
CONFIG_MODULES_COMMANDER=n
CONFIG_MODULES_CONTROL_ALLOCATOR=n
CONFIG_MODULES_DATAMAN=n
CONFIG_MODULES_EKF2=n
CONFIG_MODULES_ESC_BATTERY=n
CONFIG_MODULES_EVENTS=n
CONFIG_MODULES_FLIGHT_MODE_MANAGER=n
CONFIG_MODULES_FW_ATT_CONTROL=n
CONFIG_MODULES_FW_AUTOTUNE_ATTITUDE_CONTROL=n
CONFIG_MODULES_FW_MODE_MANAGER=n
CONFIG_MODULES_FW_LATERAL_LONGITUDINAL_CONTROL=n
CONFIG_MODULES_FW_RATE_CONTROL=n
CONFIG_MODULES_GIMBAL=n
CONFIG_MODULES_GYRO_CALIBRATION=n
CONFIG_MODULES_HARDFAULT_STREAM=n
CONFIG_MODULES_LAND_DETECTOR=n
CONFIG_MODULES_LANDING_TARGET_ESTIMATOR=n
CONFIG_MODULES_LOAD_MON=n
CONFIG_MODULES_LOGGER=n
CONFIG_MODULES_MAG_BIAS_ESTIMATOR=n
CONFIG_MODULES_MANUAL_CONTROL=n
CONFIG_MODULES_MAVLINK=y
CONFIG_USER_MAVLINK=y
CONFIG_MAVLINK_MISSION=n
CONFIG_MODULES_MC_ATT_CONTROL=n
CONFIG_MODULES_MC_AUTOTUNE_ATTITUDE_CONTROL=n
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=n
CONFIG_MODULES_MC_POS_CONTROL=n
CONFIG_MODULES_MC_RATE_CONTROL=n
CONFIG_MODULES_NAVIGATOR=n
CONFIG_MODULES_RC_UPDATE=n
CONFIG_MODULES_SENSORS=n
CONFIG_MODULES_TEMPERATURE_COMPENSATION=n
CONFIG_MODULES_UXRCE_DDS_CLIENT=n
CONFIG_MODULES_VTOL_ATT_CONTROL=n
CONFIG_SYSTEMCMDS_ACTUATOR_TEST=n
CONFIG_SYSTEMCMDS_BSONDUMP=n
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_GPIO=n
CONFIG_SYSTEMCMDS_HARDFAULT_LOG=y
CONFIG_SYSTEMCMDS_HRT_SMOKE=y
CONFIG_USER_HRT_SMOKE=y
CONFIG_SYSTEMCMDS_I2C_LAUNCHER=n
CONFIG_SYSTEMCMDS_I2CDETECT=n
CONFIG_SYSTEMCMDS_LED_CONTROL=n
CONFIG_SYSTEMCMDS_MFT=y
CONFIG_SYSTEMCMDS_MTD=y
CONFIG_SYSTEMCMDS_NETMAN=n
CONFIG_SYSTEMCMDS_NSHTERM=n
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
CONFIG_SYSTEMCMDS_REBOOT=y
# FMUv6X reset lockout controls GPIO and must run in kernel space.
CONFIG_USER_REBOOT=n
CONFIG_SYSTEMCMDS_SYSTEM_TIME=n
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_TUNE_CONTROL=n
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_UORB_SMOKE=y
CONFIG_USER_UORB_SMOKE=y
CONFIG_SYSTEMCMDS_UORB_SMOKE_KERNEL=y
CONFIG_USER_UORB_SMOKE_KERNEL=n
CONFIG_SYSTEMCMDS_UORB_WAIT_SMOKE=y
CONFIG_USER_UORB_WAIT_SMOKE=y
CONFIG_SYSTEMCMDS_UORB_WAIT_KERNEL=y
CONFIG_USER_UORB_WAIT_KERNEL=n
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_SYSTEMCMDS_WORK_QUEUE_SMOKE=y
CONFIG_USER_WORK_QUEUE_SMOKE=y
CONFIG_MODE_NAVIGATOR_VTOL_TAKEOFF=n
CONFIG_USER_WORK_QUEUE=y
